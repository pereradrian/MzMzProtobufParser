{
  "manifest_version": 2,
  "name": "Mz Mz Protobuf Parser",
  "version": "1.0.0",
  "description": "Decode and inspect Protocol Buffer (protobuf) binary data without a schema. Paste hex, Base64 or raw bytes and explore the parsed fields.",
  "homepage_url": "https://github.com/your-username/protobuf-parser-ext",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png"
  },
  "browser_action": {
    "default_icon": {
      "48": "icon-48.png",
      "96": "icon-96.png"
    },
    "default_title": "Mz Mz Protobuf Parser",
    "default_popup": "popup.html"
  },
  "permissions": [],
  "browser_specific_settings": {
    "gecko": {
      "id": "protobuf-parser@extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
